# Copy to .env.local. Never commit real values.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth (Better Auth or Auth.js; names depend on your choice)
AUTH_SECRET=

# Payments (PayHere)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Object storage (Cloudflare R2 or S3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=
